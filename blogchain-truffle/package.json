{
  "name": "blogchain-truffle",
  "version": "1.0.0",
  "private": true,
  "description": "Hợp đồng BlogChain (Truffle) - chạy cục bộ với Ganache hoặc deploy lên testnet Sepolia",
  "scripts": {
    "test": "truffle test",
    "deploy:ganache": "truffle migrate --reset && node scripts/export-contracts.js",
    "deploy:sepolia": "truffle migrate --network sepolia && node scripts/export-contracts.js",
    "export": "node scripts/export-contracts.js"
  },
  "dependencies": {
    "@truffle/hdwallet-provider": "^2.1.15",
    "dotenv": "^16.4.5"
  }
}
