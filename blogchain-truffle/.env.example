# Copy file này thành ".env" (cùng thư mục) rồi điền giá trị thật.
# File .env đã nằm trong .gitignore: KHÔNG BAO GIỜ đưa nó lên GitHub hay gửi cho ai.

# Link RPC Sepolia. Dùng được ngay, không cần đăng ký:
#   https://ethereum-sepolia-rpc.publicnode.com
# Hoặc link riêng của Infura / Alchemy:
#   https://sepolia.infura.io/v3/<API_KEY>
#   https://eth-sepolia.g.alchemy.com/v2/<API_KEY>
SEPOLIA_RPC_URL=

# Private key của MỘT tài khoản MetaMask dùng riêng để deploy (không phải seed phrase 12 từ).
# Chỉ để ETH thử nghiệm trong tài khoản này.
# MetaMask > chọn tài khoản > dấu ba chấm > Account details > Show private key
PRIVATE_KEY=

# (Không bắt buộc) Khóa API Etherscan để xác minh mã nguồn contract trên Etherscan.
# etherscan.io > đăng nhập > API Keys > Add. Dùng với: npm run verify / npm run verify:legacy
ETHERSCAN_API_KEY=
